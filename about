    <!-- SCRIPT ДЛЯ МОВИ (БЕЗ SPA НАВІГАЦІЇ) -->
    <script>
        const i18n = {
            uk: { nav_home: "Головна", nav_port: "Портфоліо", nav_about: "Про мене", nav_blog: "Блог", nav_contact: "Зв'язатися", about_name: "Сергій В'ячеславович Притула", about_role: "Традиційний та цифровий 3D-скульптор персонажів, Україна", skill_1: "Character Design", skill_2: "Sculpting", skill_3: "Texturing", skill_4: "Rendering" },
            en: { nav_home: "Home", nav_port: "Portfolio", nav_about: "About", nav_blog: "Blog", nav_contact: "Contact Me", about_name: "Serhii Viacheslavovych Prytula", about_role: "Traditional & Digital 3D Character Sculptor based in Ukraine.", skill_1: "Character Design", skill_2: "Sculpting", skill_3: "Texturing", skill_4: "Rendering" }
        };
        function setLang(lang) {
            localStorage.setItem('site_lang', lang);
            document.querySelectorAll('[data-key]').forEach(el => { const key = el.getAttribute('data-key'); if(i18n[lang][key]) el.innerText = i18n[lang][key]; });
            document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active-lang'));
            document.querySelector(`.lang-btn[onclick="setLang('${lang}')"]`).classList.add('active-lang');
        }
        const savedLang = localStorage.getItem('site_lang') || 'uk'; setLang(savedLang);
    </script>
